{
  "name": "@koyori-app/ui-vue",
  "version": "0.0.0",
  "description": "Koyori UI components for Vue",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koyori-app/ui.git",
    "directory": "packages/vue"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "prepack": "pnpm -w generate && pnpm build && node ../../scripts/copy-licenses.mjs"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/vue3-vite": "10.6.0",
    "@vitejs/plugin-vue": "6.0.8",
    "storybook": "10.6.0",
    "vite": "8.3.0",
    "vue": "3.5.42",
    "vue-tsc": "3.3.11"
  }
}
