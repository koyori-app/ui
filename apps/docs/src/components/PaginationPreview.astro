---
import { Tabs, TabItem, Code } from '@astrojs/starlight/components';
import VueDemo from '../examples/PaginationDemo.vue';
import ReactDemo from '../examples/PaginationDemo.tsx';
import vueSource from '../examples/PaginationDemo.vue?raw';
import reactSource from '../examples/PaginationDemo.tsx?raw';
---

<Tabs syncKey="framework">
  <TabItem label="Vue">
    <div class="component-preview not-content"><VueDemo client:load /></div>
    <details>
      <summary>コードを表示</summary>
      <Code code={vueSource} lang="vue" title="PaginationDemo.vue" />
    </details>
  </TabItem>
  <TabItem label="React">
    <div class="component-preview not-content"><ReactDemo client:load /></div>
    <details>
      <summary>コードを表示</summary>
      <Code code={reactSource} lang="tsx" title="PaginationDemo.tsx" />
    </details>
  </TabItem>
</Tabs>
