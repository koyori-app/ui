---
import { Tabs, TabItem, Code } from '@astrojs/starlight/components';
import VueDemo from '../examples/DropdownDemo.vue';
import ReactDemo from '../examples/DropdownDemo.tsx';
import vueSource from '../examples/DropdownDemo.vue?raw';
import reactSource from '../examples/DropdownDemo.tsx?raw';
---

<Tabs syncKey="framework">
  <TabItem label="Vue">
    <div class="component-preview not-content"><VueDemo client:only="vue"><p slot="fallback">デモを読み込んでいます…</p></VueDemo></div>
    <details>
      <summary>コードを表示</summary>
      <Code code={vueSource} lang="vue" title="DropdownDemo.vue" />
    </details>
  </TabItem>
  <TabItem label="React">
    <div class="component-preview not-content"><ReactDemo client:load /></div>
    <details>
      <summary>コードを表示</summary>
      <Code code={reactSource} lang="tsx" title="DropdownDemo.tsx" />
    </details>
  </TabItem>
</Tabs>
