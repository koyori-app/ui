---
import { Tabs, TabItem, Code } from '@astrojs/starlight/components';
import VueDemo from '../examples/HoverCardDemo.vue';
import ReactDemo from '../examples/HoverCardDemo.tsx';
import vueSource from '../examples/HoverCardDemo.vue?raw';
import reactSource from '../examples/HoverCardDemo.tsx?raw';
---

<Tabs syncKey="framework">
  <TabItem label="Vue">
    <div class="component-preview not-content"><VueDemo client:load /></div>
    <details><summary>コードを表示</summary><Code code={vueSource} lang="vue" title="HoverCardDemo.vue" /></details>
  </TabItem>
  <TabItem label="React">
    <div class="component-preview not-content"><ReactDemo client:load /></div>
    <details><summary>コードを表示</summary><Code code={reactSource} lang="tsx" title="HoverCardDemo.tsx" /></details>
  </TabItem>
</Tabs>
